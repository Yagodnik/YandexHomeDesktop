@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Qt6 6.9 COMPONENTS Core Network)
set(_yh_components "@YH_SDK_TARGETS@")
set(_yh_requested "${YandexHome_FIND_COMPONENTS}")
if(NOT _yh_requested)
  set(_yh_requested "${_yh_components}")
endif()
if(AppRest IN_LIST _yh_requested AND AppRest IN_LIST _yh_components)
  find_dependency(Qt6 6.9 COMPONENTS HttpServer)
endif()
if(YandexOAuth IN_LIST _yh_requested AND YandexOAuth IN_LIST _yh_components)
  find_dependency(Qt6 6.9 COMPONENTS Gui NetworkAuth)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/YandexHomeTargets.cmake")
foreach(_component IN LISTS YandexHome_FIND_COMPONENTS)
  if(TARGET YandexHome::${_component})
    set(YandexHome_${_component}_FOUND TRUE)
  else()
    set(YandexHome_${_component}_FOUND FALSE)
  endif()
endforeach()
check_required_components(YandexHome)
