list(REMOVE_DUPLICATES DLLS)
file(MAKE_DIRECTORY "${DESTINATION}")
file(MAKE_DIRECTORY "${DESTINATION}/Testing")
set(_manifest "${DESTINATION}/Testing/WindowsRuntime.txt")
file(WRITE "${_manifest}" "Runtime DLL sources for ${DESTINATION}\n")
foreach(_dll IN LISTS DLLS)
  if(_dll STREQUAL "")
    continue()
  endif()
  file(APPEND "${_manifest}" "${_dll}\n")
  get_filename_component(_directory "${_dll}" DIRECTORY)
  if(NOT _directory STREQUAL DESTINATION)
    get_filename_component(_name "${_dll}" NAME)
    file(COPY_FILE "${_dll}" "${DESTINATION}/${_name}" ONLY_IF_DIFFERENT)
  endif()
endforeach()
message(STATUS "Windows runtime manifest: ${_manifest}")
