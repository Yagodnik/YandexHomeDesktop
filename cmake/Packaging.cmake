# CPack packages the same install rules used by `just install`.
if(NOT BUILD_CLI_APP OR NOT BUILD_REST_APP)
  message(FATAL_ERROR "Release packages require BUILD_CLI_APP and BUILD_REST_APP")
endif()
if((WIN32 OR APPLE) AND (NOT BUILD_DESKTOP_APP OR NOT BUILD_SHORTCUTS_APP))
  message(FATAL_ERROR "Desktop packages require BUILD_DESKTOP_APP and BUILD_SHORTCUTS_APP")
endif()

set(CPACK_PACKAGE_NAME YandexHomeDesktop)
set(CPACK_PACKAGE_VENDOR Yagodnik)
set(CPACK_PACKAGE_VERSION ${PROJECT_VERSION})
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Yandex smart home applications")
set(CPACK_RESOURCE_FILE_LICENSE "${PROJECT_SOURCE_DIR}/LICENSE")
set(CPACK_PACKAGE_DIRECTORY "${PROJECT_BINARY_DIR}/dist")
set(CPACK_VERBATIM_VARIABLES ON)

string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" _package_arch)
if(_package_arch MATCHES "^(amd64|x86_64)$")
  set(_package_arch x64)
elseif(_package_arch STREQUAL "aarch64")
  set(_package_arch arm64)
endif()
if(WIN32)
  set(CPACK_GENERATOR NSIS)
  set(_package_platform "windows-${_package_arch}")
  set(YH_PACKAGE_EXTENSION .exe)
  set(CPACK_PACKAGE_EXECUTABLES "YandexHomeDesktop" "Yandex Home Desktop")
  set(CPACK_PACKAGE_INSTALL_DIRECTORY YandexHomeDesktop)
  set(CPACK_NSIS_DISPLAY_NAME "Yandex Home Desktop")
elseif(APPLE)
  set(CPACK_GENERATOR DragNDrop)
  set(YH_PACKAGE_EXTENSION .dmg)
  if(CMAKE_OSX_ARCHITECTURES)
    set(_package_archs ${CMAKE_OSX_ARCHITECTURES})
  else()
    set(_package_archs ${CMAKE_SYSTEM_PROCESSOR})
  endif()
  list(REMOVE_DUPLICATES _package_archs)
  list(SORT _package_archs)
  if(_package_archs STREQUAL "arm64;x86_64")
    set(_package_arch universal)
  else()
    list(JOIN _package_archs "-" _package_arch)
  endif()
  set(_package_platform "macos-${_package_arch}")
  # The DMG contains the deployed bundle, without the standalone SDK install.
  set(CPACK_INSTALL_CMAKE_PROJECTS "${PROJECT_BINARY_DIR};${PROJECT_NAME};DesktopBundle;/")
  set(CPACK_DMG_VOLUME_NAME "Yandex Home Desktop")
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
  set(CPACK_GENERATOR TGZ)
  set(YH_PACKAGE_EXTENSION .tar.gz)
  set(_package_platform "linux-${_package_arch}")
  set(CPACK_INCLUDE_TOPLEVEL_DIRECTORY ON)
  install(FILES "${PROJECT_SOURCE_DIR}/docs/linux-package.md" DESTINATION . RENAME README.md)
  install(FILES "${PROJECT_SOURCE_DIR}/LICENSE" DESTINATION .)
else()
  message(FATAL_ERROR "Release packaging is supported on Windows, macOS, and Linux")
endif()
set(YH_PACKAGE_FILE_NAME "YandexHomeDesktop-${PROJECT_VERSION}-${_package_platform}")
set(CPACK_PACKAGE_FILE_NAME "${YH_PACKAGE_FILE_NAME}")
include(CPack)
configure_file("${CMAKE_CURRENT_LIST_DIR}/CheckPackage.cmake.in"
  "${PROJECT_BINARY_DIR}/CheckPackage.cmake" @ONLY)
