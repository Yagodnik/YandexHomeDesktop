# The catalog owns feature/layer labels; CTest owns commands and environments.
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
  "${PROJECT_SOURCE_DIR}/tests/catalog.json")
file(READ "${PROJECT_SOURCE_DIR}/tests/catalog.json" _yh_test_catalog)
string(JSON _yh_suite_count LENGTH "${_yh_test_catalog}" suites)
math(EXPR _yh_last_suite "${_yh_suite_count} - 1")
foreach(_index RANGE ${_yh_last_suite})
  string(JSON _id GET "${_yh_test_catalog}" suites ${_index} id)
  string(JSON _layer GET "${_yh_test_catalog}" suites ${_index} layer)
  string(JSON _feature_count LENGTH "${_yh_test_catalog}" suites ${_index} features)
  set(_labels "${_layer}")
  math(EXPR _last_feature "${_feature_count} - 1")
  foreach(_feature RANGE ${_last_feature})
    string(JSON _label GET "${_yh_test_catalog}" suites ${_index} features ${_feature})
    list(APPEND _labels "${_label}")
  endforeach()
  set_property(GLOBAL PROPERTY "YH_TEST_LABELS_${_id}" "${_labels}")
endforeach()

function(yh_add_test)
  cmake_parse_arguments(PARSE_ARGV 0 _test "" "NAME" "")
  get_property(_labels GLOBAL PROPERTY "YH_TEST_LABELS_${_test_NAME}")
  if(NOT _labels)
    message(FATAL_ERROR "Test ${_test_NAME} needs an entry in tests/catalog.json")
  endif()
  add_test(${ARGV})
  set_tests_properties(${_test_NAME} PROPERTIES LABELS "${_labels}" TIMEOUT 30)
endfunction()
