cmake_minimum_required(VERSION 3.28)

# PACKAGE_ROOT also lets CI check a silently installed Windows installer.
if(DEFINED PACKAGE_ROOT)
  if("@CMAKE_SYSTEM_NAME@" STREQUAL "Darwin")
    set(_contents "${PACKAGE_ROOT}/YandexHomeDesktop.app/Contents")
    set(_bin "${_contents}/MacOS")
    foreach(_required MacOS/YandexHomeDesktop PlugIns Frameworks/QtCore.framework/QtCore
        Frameworks/QtMultimedia.framework/QtMultimedia PlugIns/multimedia/libffmpegmediaplugin.dylib)
      if(NOT EXISTS "${_contents}/${_required}")
        message(FATAL_ERROR "Missing packaged file or directory: ${_contents}/${_required}")
      endif()
    endforeach()
    execute_process(COMMAND codesign --verify --deep --strict --verbose=2
      "${PACKAGE_ROOT}/YandexHomeDesktop.app"
      RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _error)
    if(NOT "${_result}" STREQUAL "0")
      message(FATAL_ERROR "Packaged app signature is invalid: ${_result}\n${_output}${_error}")
    endif()
    foreach(_arch IN ITEMS @_package_archs@)
      foreach(_binary YandexHomeDesktop YandexHomeCli YandexHomeRest YandexHomeShortcuts)
        execute_process(COMMAND lipo "${_bin}/${_binary}" -verify_arch "${_arch}"
          COMMAND_ERROR_IS_FATAL ANY)
      endforeach()
      execute_process(COMMAND lipo "${_contents}/Frameworks/QtCore.framework/QtCore"
        -verify_arch "${_arch}" COMMAND_ERROR_IS_FATAL ANY)
    endforeach()
  else()
    set(_bin "${PACKAGE_ROOT}/@CMAKE_INSTALL_BINDIR@")
    if("@CMAKE_SYSTEM_NAME@" STREQUAL "Windows")
      foreach(_required YandexHomeDesktop.exe Qt6Core.dll qwindows.dll
          Qt6Multimedia.dll ffmpegmediaplugin.dll)
        file(GLOB_RECURSE _matches "${PACKAGE_ROOT}/${_required}")
        if(NOT _matches)
          message(FATAL_ERROR "Missing packaged file: ${_required}")
        endif()
      endforeach()
      if("@MINGW@")
        foreach(_required libstdc++-6.dll libgcc_s_seh-1.dll libwinpthread-1.dll)
          file(GLOB_RECURSE _matches "${PACKAGE_ROOT}/${_required}")
          if(NOT _matches)
            message(FATAL_ERROR "Missing MinGW runtime: ${_required}")
          endif()
        endforeach()
      endif()
    endif()
  endif()
  set(_consoles YandexHomeCli YandexHomeRest)
  if("@BUILD_SHORTCUTS_APP@")
    list(APPEND _consoles YandexHomeShortcuts)
  endif()
  foreach(_console IN LISTS _consoles)
    execute_process(COMMAND "${_bin}/${_console}@CMAKE_EXECUTABLE_SUFFIX@" --help --json
      RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _error TIMEOUT 10)
    if(NOT "${_result}" STREQUAL "0")
      message(FATAL_ERROR "Packaged ${_console} failed: ${_result}\n${_output}${_error}")
    endif()
    string(JSON _ok ERROR_VARIABLE _json_error GET "${_output}" ok)
    if(_json_error OR NOT _ok)
      message(FATAL_ERROR "Packaged ${_console} returned invalid help: ${_output}${_error}")
    endif()
  endforeach()
  return()
endif()

set(_package "@CPACK_PACKAGE_DIRECTORY@/@YH_PACKAGE_FILE_NAME@@YH_PACKAGE_EXTENSION@")
if(NOT EXISTS "${_package}")
  message(FATAL_ERROR "Package not found: ${_package}")
endif()
file(SIZE "${_package}" _size)
if(_size EQUAL 0)
  message(FATAL_ERROR "Empty package: ${_package}")
endif()
set(_check_dir "@PROJECT_BINARY_DIR@/package-check")
if("@CMAKE_SYSTEM_NAME@" STREQUAL "Darwin")
  file(MAKE_DIRECTORY "${_check_dir}")
  execute_process(COMMAND hdiutil attach "${_package}" -mountpoint "${_check_dir}"
    -nobrowse -readonly COMMAND_ERROR_IS_FATAL ANY)
  set(_root "${_check_dir}")
elseif("@CMAKE_SYSTEM_NAME@" STREQUAL "Windows")
  # Inspect CPack's deployed payload locally; CI also tests the actual installer.
  file(GLOB _roots "@CPACK_PACKAGE_DIRECTORY@/_CPack_Packages/*/NSIS/@YH_PACKAGE_FILE_NAME@")
  list(LENGTH _roots _count)
  if(NOT _count EQUAL 1)
    message(FATAL_ERROR "Expected one CPack NSIS staging directory, found ${_count}")
  endif()
  list(GET _roots 0 _root)
else()
  file(REMOVE_RECURSE "${_check_dir}")
  file(MAKE_DIRECTORY "${_check_dir}")
  file(ARCHIVE_EXTRACT INPUT "${_package}" DESTINATION "${_check_dir}")
  set(_root "${_check_dir}/@YH_PACKAGE_FILE_NAME@")
endif()

execute_process(COMMAND "${CMAKE_COMMAND}" "-DPACKAGE_ROOT=${_root}"
  -P "${CMAKE_CURRENT_LIST_FILE}" RESULT_VARIABLE _result)
# Always detach the DMG, including when a content or executable check fails.
if("@CMAKE_SYSTEM_NAME@" STREQUAL "Darwin")
  execute_process(COMMAND hdiutil detach "${_check_dir}" COMMAND_ERROR_IS_FATAL ANY)
endif()
if(NOT "@CMAKE_SYSTEM_NAME@" STREQUAL "Windows")
  file(REMOVE_RECURSE "${_check_dir}")
endif()
if(NOT "${_result}" STREQUAL "0")
  message(FATAL_ERROR "Package verification failed: ${_package}")
endif()
message(STATUS "Verified package: ${_package}")
